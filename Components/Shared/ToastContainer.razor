@using Reboot.Models
@using Reboot.Services
@inject IToastService ToastService
@implements IDisposable

<div class="toast-viewport" aria-live="polite" aria-atomic="false" role="region" aria-label="Notifications">
    @foreach (var toast in _toasts)
    {
        <div @key="toast.Id" class="toast-item toast-@toast.Type.ToString().ToLower()">
            <!-- Icon Badge -->
            <div class="toast-icon">
                @switch (toast.Type)
                {
                    case ToastType.Success:
                        <svg class="toast-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        break;
                    case ToastType.Error:
                        <svg class="toast-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        break;
                    case ToastType.Warning:
                        <svg class="toast-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        break;
                    default:
                        <svg class="toast-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        break;
                }
            </div>

            <!-- Content Area -->
            <div class="toast-content">
                @if (!string.IsNullOrWhiteSpace(toast.Title))
                {
                    <div class="toast-title">@toast.Title</div>
                }
                <p class="toast-message">@toast.Message</p>
            </div>

            <!-- Dismiss Button -->
            <button type="button"
                    @onclick="() => DismissToast(toast.Id)"
                    class="toast-close"
                    title="Dismiss">
                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();
    private bool _isDisposed = false;

    protected override void OnInitialized()
    {
        ToastService.OnShow += HandleShowToast;
        ToastService.OnDismiss += DismissToast;
    }

    private void HandleShowToast(ToastMessage toast)
    {
        if (_isDisposed) return;
        InvokeAsync(async () =>
        {
            if (_isDisposed) return;
            _toasts.Add(toast);
            StateHasChanged();

            // Auto-dismiss after duration
            if (toast.DurationMs > 0)
            {
                await Task.Delay(toast.DurationMs);
                if (!_isDisposed)
                {
                    DismissToast(toast.Id);
                }
            }
        });
    }

    private void DismissToast(Guid id)
    {
        if (_isDisposed) return;
        InvokeAsync(() =>
        {
            if (_isDisposed) return;
            var item = _toasts.FirstOrDefault(t => t.Id == id);
            if (item != null)
            {
                _toasts.Remove(item);
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        _isDisposed = true;
        ToastService.OnShow -= HandleShowToast;
        ToastService.OnDismiss -= DismissToast;
    }
}
