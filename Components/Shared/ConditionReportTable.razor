@using Reboot.Models

<div class="border border-zinc-200 rounded-sm bg-white overflow-hidden @CustomClass">
    <!-- Header summary bar -->
    <div class="px-4 py-3 bg-zinc-50 border-b border-zinc-200 flex items-center justify-between">
        <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 font-mono">Verified Condition Checklist</h4>
            <p class="text-xs text-zinc-500 mt-0.5">Physical and diagnostic checks performed by seller</p>
        </div>
        <div class="font-mono text-xs tabular-nums text-zinc-700 bg-white border border-zinc-200 px-2.5 py-1 rounded-sm">
            @Report.PassedCount / @Report.TotalCount passed
        </div>
    </div>

    <!-- Table of checks -->
    <table class="w-full text-left border-collapse text-xs">
        <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50/50 text-zinc-500 font-mono uppercase text-[10px] tracking-wider">
                <th class="py-2 px-4 font-medium w-1/3">Item Check</th>
                <th class="py-2 px-4 font-medium w-28">Status</th>
                <th class="py-2 px-4 font-medium">Diagnostic Notes</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
            @foreach (var check in Report.Checks)
            {
                <tr class="hover:bg-zinc-50/50 transition-colors">
                    <td class="py-2.5 px-4 font-medium text-zinc-900">
                        @check.Name
                    </td>
                    <td class="py-2.5 px-4 whitespace-nowrap">
                        @if (check.Passed)
                        {
                            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-zinc-900">
                                <svg class="w-3.5 h-3.5 stroke-zinc-900" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>Passed</span>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-red-700">
                                <svg class="w-3.5 h-3.5 stroke-red-600" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                                <span>Failed</span>
                            </span>
                        }
                    </td>
                    <td class="py-2.5 px-4 text-zinc-600">
                        @(string.IsNullOrWhiteSpace(check.Notes) ? "—" : check.Notes)
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Known defects block -->
    <div class="px-4 py-3 border-t border-zinc-200 bg-zinc-50/40">
        <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-500 block mb-1">Disclosed Defects & Cosmetic Notes</span>
        <p class="text-xs text-zinc-800 leading-relaxed">
            @if (string.IsNullOrWhiteSpace(Report.KnownDefects) || Report.KnownDefects.Trim().Equals("None", StringComparison.OrdinalIgnoreCase))
            {
                <span class="text-zinc-500 italic">No defects disclosed by seller. Verified in nominal condition.</span>
            }
            else
            {
                @Report.KnownDefects
            }
        </p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ConditionReport Report { get; set; } = new();
    [Parameter] public string? CustomClass { get; set; }
}
