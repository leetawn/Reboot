@using Reboot.Models
@using Reboot.Services
@inject IReputationService ReputationService
@inject IUserService UserService

<div class="border border-zinc-200 rounded-sm bg-white p-4 @CustomClass">
    <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-sm bg-zinc-100 border border-zinc-200 flex items-center justify-center font-mono text-xs font-semibold text-zinc-800">
                @UserInitials
            </div>
            <div>
                <div class="flex items-center gap-1.5">
                    <a href="/seller/@Seller.Id" class="text-sm font-semibold text-zinc-900 hover:underline">
                        @Seller.DisplayName
                    </a>
                    @if (Seller.IsVerified)
                    {
                        <span class="inline-flex items-center gap-0.5 text-[11px] font-mono font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 px-1.5 py-0.2 rounded-sm" title="Identity Verified">
                            <svg class="w-3 h-3 stroke-emerald-700" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                            <span>Verified</span>
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-0.5 text-[11px] font-mono text-zinc-500 bg-zinc-100 border border-zinc-200 px-1.5 py-0.2 rounded-sm">
                            Unverified
                        </span>
                    }
                </div>
                <div class="text-xs text-zinc-500 mt-0.5">
                    <span>@Seller.Location, replies @Record.AverageResponseTime</span>
                </div>
            </div>
        </div>

        @if (ShowViewProfileButton)
        {
            <a href="/seller/@Seller.Id" class="text-xs font-mono font-medium text-zinc-900 hover:text-zinc-600 underline underline-offset-4">
                Profile →
            </a>
        }
    </div>

    <!-- Plain facts record -->
    <div class="mt-3 pt-3 border-t border-zinc-100">
        <div class="font-mono text-[11px] text-zinc-700 leading-relaxed">
            @Record.FormattedSummary
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public User Seller { get; set; } = new();
    [Parameter] public bool ShowViewProfileButton { get; set; } = true;
    [Parameter] public string? CustomClass { get; set; }

    private SellerReliabilityRecord Record => ReputationService.GetSellerRecord(Seller.Id);

    private string UserInitials => string.IsNullOrWhiteSpace(Seller.DisplayName) ? "U" : Seller.DisplayName[..1].ToUpperInvariant();
}
