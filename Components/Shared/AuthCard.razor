<div class="min-h-[calc(100vh-14rem)] flex flex-col justify-center items-center py-12 px-4 sm:px-6">
    <div class="w-full @(string.IsNullOrWhiteSpace(WidthClass) ? "max-w-[440px]" : WidthClass)">
        <div class="bg-white border border-[#dadce0] rounded-lg p-8 sm:p-10 shadow-none">
            <!-- Brand Wordmark -->
            <div class="mb-5">
                <a href="/" class="text-[22px] font-medium tracking-tight text-zinc-900 hover:text-zinc-700 transition-colors">
                    @AppConfig.AppName
                </a>
            </div>

            <!-- Header -->
            <div class="mb-6">
                <h1 class="text-xl sm:text-2xl font-normal text-zinc-900 tracking-tight">
                    @Title
                </h1>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="text-sm text-zinc-600 mt-1.5">
                        @Subtitle
                    </p>
                }
            </div>

            <!-- Error Banner -->
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="mb-6 p-3 bg-red-50 border border-red-200 rounded-md text-xs text-red-800 flex items-start gap-2" role="alert" aria-live="polite">
                    <svg class="w-4 h-4 text-red-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>@ErrorMessage</span>
                </div>
            }

            <!-- Success Banner -->
            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="mb-6 p-3 bg-emerald-50 border border-emerald-200 rounded-md text-xs text-emerald-800 flex items-start gap-2" role="status" aria-live="polite">
                    <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span>@SuccessMessage</span>
                </div>
            }

            <!-- Card Body Content -->
            @ChildContent
        </div>

        <!-- Card Bottom Links -->
        <div class="mt-4 flex items-center justify-between text-xs text-zinc-500 px-2">
            <span>English (Philippines)</span>
            <div class="flex items-center gap-4">
                <a href="/terms" class="hover:text-zinc-800 transition-colors">Terms</a>
                <a href="/privacy" class="hover:text-zinc-800 transition-colors">Privacy</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public string? WidthClass { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
