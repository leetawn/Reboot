@using Reboot.Models
@using Reboot.Services
@inject IUserService UserService

<a href="/listing/@Listing.Id" class="group block border border-zinc-200 bg-white hover:border-zinc-400 transition-colors duration-150 rounded-md overflow-hidden flex flex-col h-full @CustomClass">
    <!-- Image block: Display real photo if available, or architectural monogram fallback -->
    <div class="relative bg-zinc-100 w-full flex flex-col items-center justify-center border-b border-zinc-200 overflow-hidden" style="height: 190px; width: 100%;">

        @if (Listing.Status == ListingStatus.Reserved)
        {
            <div class="absolute top-2.5 right-2.5 z-10">
                <span class="text-[10px] uppercase tracking-wider bg-zinc-900 text-white px-2 py-0.5 rounded-md font-medium">
                    Reserved
                </span>
            </div>
        }
        else if (Listing.Status == ListingStatus.Sold)
        {
            <div class="absolute top-2.5 right-2.5 z-10">
                <span class="text-[10px] uppercase tracking-wider bg-zinc-400 text-white px-2 py-0.5 rounded-md font-medium">
                    Sold
                </span>
            </div>
        }

        @if (!string.IsNullOrEmpty(PrimaryPhotoUrl))
        {
            <img src="@PrimaryPhotoUrl" alt="@Listing.Title" class="group-hover:scale-105 transition-transform duration-200" style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />
        }
        else
        {
            <!-- Neutral architectural monogram / category code -->
            <div class="flex flex-col items-center justify-center text-zinc-400 group-hover:text-zinc-600 transition-colors p-4">
                <span class="font-mono text-2xl font-bold tracking-widest uppercase">
                    @CategoryShortCode
                </span>
                <span class="text-[10px] tracking-wider uppercase text-zinc-400 mt-1 font-medium">
                    @Listing.Brand
                </span>
            </div>
        }

        @if (Listing.WarrantyOffered.HasValue && Listing.WarrantyOffered.Value > 0)
        {
            <div class="absolute bottom-2.5 left-2.5 z-10">
                <span class="text-[10px] text-zinc-600 bg-white/90 border border-zinc-200 px-1.5 py-0.5 rounded-md">
                    @(Listing.WarrantyOffered.Value)d warranty
                </span>
            </div>
        }
    </div>

    <!-- Content details -->
    <div class="p-3.5 flex flex-col flex-1 justify-between gap-3">
        <div>
            <div class="flex items-baseline justify-between gap-2">
                <PriceTag Amount="@Listing.Price" AmountClass="text-lg font-bold" />
                <div class="flex items-center gap-1.5 flex-shrink-0">
                    <GradeBadge Grade="@Listing.Grade" />
                    <span class="text-[11px] text-zinc-400">
                        @Listing.Category.ToString()
                    </span>
                </div>
            </div>

            <h3 class="text-sm font-medium text-zinc-900 mt-1.5 line-clamp-2 group-hover:text-zinc-700 leading-snug">
                @Listing.Title
            </h3>
        </div>

        <!-- Seller info and location -->
        <div class="pt-2.5 border-t border-zinc-100 flex items-center justify-between text-xs text-zinc-500">
            <div class="flex items-center gap-1.5 truncate">
                <span class="font-medium text-zinc-700 truncate">@(Seller?.DisplayName ?? "Seller")</span>
                @if (Seller?.IsVerified == true)
                {
                    <svg class="w-3.5 h-3.5 stroke-emerald-700 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" title="Verified Seller">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                }
            </div>
            <span class="text-[11px] text-zinc-400 flex-shrink-0">
                @(Seller?.Location ?? "Cebu")
            </span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public Listing Listing { get; set; } = new();
    [Parameter] public string? CustomClass { get; set; }

    private User? Seller => UserService.GetUserById(Listing.SellerId);

    private string? PrimaryPhotoUrl => Listing.Photos?.FirstOrDefault(p =>
        !string.IsNullOrWhiteSpace(p) &&
        (p.StartsWith("data:image", StringComparison.OrdinalIgnoreCase) ||
         p.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
         p.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
         p.StartsWith("/", StringComparison.OrdinalIgnoreCase)));

    private string CategoryShortCode => Listing.Category switch
    {
        ListingCategory.Console => "CNSL",
        ListingCategory.Controller => "CTRL",
        ListingCategory.Handheld => "HNDH",
        ListingCategory.PCPart => "PC-PT",
        ListingCategory.Laptop => "LPTOP",
        ListingCategory.Accessory => "ACC",
        _ => "GEAR"
    };
}
