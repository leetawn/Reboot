<div class="border-b border-zinc-200 pb-5 mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4 @CustomClass">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">
            @Title
        </h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="mt-1.5 text-sm text-zinc-600 max-w-2xl">
                @Description
            </p>
        }
    </div>
    @if (Actions != null)
    {
        <div class="flex items-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? CustomClass { get; set; }
}
