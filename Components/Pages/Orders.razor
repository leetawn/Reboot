    private async Task HandleSendOrderMessage()
    {
        if (_selectedOrder == null || string.IsNullOrWhiteSpace(_newOrderMessage)) return;

        var msgText = _newOrderMessage.Trim();
        _activeAction = "msg";
        StateHasChanged();
        await Task.Delay(150);

        var result = OrderService.AddOrderMessage(_selectedOrder.Id, CurrentUserService.UserId, msgText);
        _activeAction = null;
        if (result.Success)
        {
            _newOrderMessage = string.Empty;
        }
        else
        {
            _isError = true;
            _feedbackMessage = result.Message;
        }

        LoadOrders();
    }

