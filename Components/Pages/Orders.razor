@page "/my/orders"
@using Reboot.Models
@using Reboot.Services
@inject IOrderService OrderService
@inject IOfferService OfferService
@inject IListingService ListingService
@inject IDisputeService DisputeService
@inject IUserService UserService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Orders &amp; Escrow | @AppConfig.AppName</PageTitle>

<PageHeader Title="Orders &amp; escrow tracking"
            Description="All orders are protected by the Reboot platform escrow state machine. Review active timers, coordinate meetups, release payouts, or file inspection disputes." />

@if (!CurrentUserService.IsSignedIn)
{
    <div class="bg-white border border-zinc-200 rounded-md p-8 text-center max-w-md mx-auto my-8">
        <h3 class="text-sm font-semibold text-zinc-900">Sign in required</h3>
        <p class="text-xs text-zinc-600 mt-1 mb-4">You must be signed in to view your orders and offers.</p>
        <a href="/login?returnUrl=/my/orders" class="inline-block px-4 py-2 bg-zinc-900 text-white text-xs font-medium rounded-md hover:bg-zinc-800 transition-colors">Sign in</a>
    </div>
}
else
{
    <!-- Filter tabs -->
    <div class="flex items-center gap-1.5 border-b border-zinc-200 pb-2 mb-6 font-mono text-xs overflow-x-auto">
        @foreach (var tab in new[] { "All Orders", "Buying", "Selling", "Active Escrow", "Completed", "My Offers" })
        {
            var isSelected = _selectedTab == tab;
            <button type="button" @onclick="() => SetTab(tab)" class="px-3 py-1.5 rounded-sm border transition-colors @(isSelected ? "bg-zinc-900 text-white border-zinc-900 font-semibold" : "bg-white text-zinc-700 border-zinc-200 hover:border-zinc-300")">
                @tab
            </button>
        }
    </div>

    @if (_selectedTab == "My Offers")
    {
        var myOffers = OfferService.GetOffersByBuyer(CurrentUserService.UserId);
        if (myOffers.Count == 0)
        {
            <div class="bg-white border border-dashed border-zinc-300 rounded-sm p-12 text-center">
                <h3 class="text-sm font-semibold text-zinc-900 font-mono">No Offers Made</h3>
                <p class="text-xs text-zinc-500 mt-1">You haven't submitted any offers on marketplace listings yet.</p>
                <a href="/browse" class="mt-4 inline-block px-4 py-2 bg-zinc-900 text-white text-xs font-medium rounded-sm">Browse Listings</a>
            </div>
        }
        else
        {
            <div class="bg-white border border-zinc-200 rounded-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-200 flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-sm text-zinc-900 font-mono uppercase">Offers Submitted by You</h3>
                        <p class="text-xs text-zinc-500">Track offer negotiation status with sellers across Metro Cebu.</p>
                    </div>
                    <span class="text-xs font-mono px-2 py-0.5 bg-zinc-100 text-zinc-700 rounded-sm">@myOffers.Count offer(s)</span>
                </div>
                <div class="divide-y divide-zinc-100">
                    @foreach (var offer in myOffers.OrderByDescending(o => o.CreatedDate))
                    {
                        var listing = ListingService.GetListingById(offer.ListingId);
                        var seller = listing != null ? UserService.GetUserById(listing.SellerId) : null;
                        <div class="p-4 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-zinc-50 transition-colors">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-[10px] uppercase px-1.5 py-0.5 rounded-sm font-semibold @GetOfferStatusBadgeClass(offer.Status)">
                                        @offer.Status.ToString()
                                    </span>
                                    <span class="text-[11px] text-zinc-400 font-mono">@offer.CreatedDate.ToString("MMM dd, yyyy HH:mm") UTC</span>
                                </div>
                                <h4 class="font-medium text-zinc-900 text-sm">
                                    <a href="/listings/@offer.ListingId" class="hover:underline">@(listing?.Title ?? "Listing Unavailable")</a>
                                </h4>
                                <div class="text-xs text-zinc-600 flex items-center gap-3">
                                    <span>Seller: <strong class="text-zinc-900">@(seller?.DisplayName ?? "User")</strong></span>
                                    @if (listing != null)
                                    {
                                        <span>Asking Price: <strong class="text-zinc-500 line-through">@AppConfig.FormatPrice(listing.Price)</strong></span>
                                    }
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="text-right">
                                    <span class="text-[10px] font-mono text-zinc-400 block uppercase">Your Offer</span>
                                    <PriceTag Amount="@offer.Amount" AmountClass="text-base font-bold text-zinc-900" />
                                </div>
                                <a href="/listings/@offer.ListingId" class="px-3 py-1.5 border border-zinc-200 text-xs font-medium rounded-sm hover:bg-zinc-100 transition-colors text-zinc-700">
                                    View Listing
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (FilteredOrders.Count == 0)
    {
        <div class="bg-white border border-dashed border-zinc-300 rounded-sm p-12 text-center">
            <h3 class="text-sm font-semibold text-zinc-900 font-mono">No Orders Found</h3>
            <p class="text-xs text-zinc-500 mt-1">There are no orders matching "@_selectedTab" for your account.</p>
            <a href="/browse" class="mt-4 inline-block px-4 py-2 bg-zinc-900 text-white text-xs font-medium rounded-sm">Browse Listings</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left 5 columns: Orders List -->
            <div class="lg:col-span-5 space-y-3">
                @foreach (var order in FilteredOrders)
                {
                    var listing = ListingService.GetListingById(order.ListingId);
                    var isSelected = _selectedOrder?.Id == order.Id;
                    var isBuyer = order.BuyerId == CurrentUserService.UserId;
                    var counterparty = isBuyer ? UserService.GetUserById(order.SellerId) : UserService.GetUserById(order.BuyerId);

                    <div @onclick="() => SelectOrder(order)" class="cursor-pointer border rounded-sm p-4 bg-white transition-all text-xs @(isSelected ? "border-zinc-900 ring-1 ring-zinc-900" : "border-zinc-200 hover:border-zinc-400")">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400 block mb-0.5">
                                    @(isBuyer ? "Buying from" : "Selling to") @(counterparty?.DisplayName ?? "User")
                                </span>
                                <h4 class="font-medium text-zinc-900 line-clamp-1">
                                    @(listing?.Title ?? "Marketplace Item")
                                </h4>
                            </div>
                            <PriceTag Amount="@order.Price" AmountClass="font-bold text-sm" />
                        </div>

                        <div class="mt-3 pt-2.5 border-t border-zinc-100 flex items-center justify-between text-[11px] font-mono">
                            <span class="px-2 py-0.5 rounded-sm font-semibold uppercase text-[10px] @GetStatusBadgeClass(order.Status)">
                                @order.Status.ToString()
                            </span>
                            <span class="text-zinc-400 tabular-nums">
                                @order.CreatedDate.ToString("yyyy-MM-dd")
                            </span>
                        </div>
                    </div>
                }
            </div>

            <!-- Right 7 columns: Detailed Order View & Escrow Actions -->
            <div class="lg:col-span-7">
                @if (_selectedOrder != null)
                {
                    var order = _selectedOrder;
                    var listing = ListingService.GetListingById(order.ListingId);
                    var isBuyer = order.BuyerId == CurrentUserService.UserId;
                    var isSeller = order.SellerId == CurrentUserService.UserId;
                    var counterparty = isBuyer ? UserService.GetUserById(order.SellerId) : UserService.GetUserById(order.BuyerId);
                    var activeDispute = DisputeService.GetDisputeByOrderId(order.Id);

                    <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-6">
                        <!-- Order Title Header -->
                        <div class="border-b border-zinc-100 pb-4">
                            <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500 mb-1">
                                <span>ORDER #@order.Id.ToString()[..8].ToUpperInvariant()</span>
                                <span>@order.CreatedDate.ToString("MMM dd, yyyy HH:mm") UTC</span>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                                <h2 class="text-lg font-bold text-zinc-900">
                                    @(listing?.Title ?? "Marketplace Item")
                                </h2>
                                <PriceTag Amount="@order.Price" AmountClass="text-xl font-bold" />
                            </div>
                            <div class="mt-2 text-xs text-zinc-600 flex flex-wrap items-center gap-x-4 gap-y-1">
                                <span>Role: <strong class="text-zinc-900">@(isBuyer ? "Buyer" : "Seller")</strong></span>
                                <span>Counterparty: <strong class="text-zinc-900">@(counterparty?.DisplayName ?? "User")</strong> (@(counterparty?.Location ?? "Cebu"))</span>
                                <span>Delivery: <strong>@order.DeliveryMethod.ToString()</strong></span>
                            </div>
                        </div>

                        <!-- Horizontal Escrow Step Indicator -->
                        <div>
                            <EscrowSteps CurrentStatus="@order.Status" />
                        </div>

                        <!-- Active Window Countdown Timers -->
                        @if (order.Status == OrderStatus.Reserved && order.ReservedUntil.HasValue)
                        {
                            <div class="p-3 bg-amber-50 border border-amber-300 rounded-sm flex items-center justify-between gap-3 text-xs">
                                <div class="font-mono text-amber-900">
                                    <strong>24-Hour Reservation Window Active</strong>
                                    <div class="text-[11px] text-amber-800 opacity-90">Complete payment to lock funds in escrow.</div>
                                </div>
                                <CountdownLabel Deadline="@order.ReservedUntil" Prefix="" TextClass="text-amber-900 font-bold" OnExpired="RefreshCurrentOrder" />
                            </div>
                        }
                        else if (order.Status == OrderStatus.Paid && order.DispatchDeadline.HasValue)
                        {
                            <div class="p-3 @(order.IsDispatchOverdue ? "bg-red-50 border border-red-300 text-red-900" : "bg-blue-50 border border-blue-300 text-blue-900") rounded-sm flex items-center justify-between gap-3 text-xs">
                                <div class="font-mono">
                                    <strong>72-Hour Seller Dispatch Window Active</strong>
                                    <div class="text-[11px] opacity-90">
                                        @(order.IsDispatchOverdue ? "Seller missed dispatch deadline. Escrow refund protection is active." : "Seller must dispatch or hand over the item before deadline.")
                                    </div>
                                </div>
                                @if (!order.IsDispatchOverdue)
                                {
                                    <CountdownLabel Deadline="@order.DispatchDeadline" Prefix="" TextClass="font-bold font-mono" OnExpired="RefreshCurrentOrder" />
                                }
                                else
                                {
                                    <span class="font-bold font-mono text-red-700">DEADLINE ELAPSED</span>
                                }
                            </div>
                        }
                        else if (order.Status == OrderStatus.HandedOverOrShipped && order.InspectionDeadline.HasValue)
                        {
                            <div class="p-3 bg-zinc-100 border border-zinc-300 rounded-sm flex items-center justify-between gap-3 text-xs">
                                <div class="font-mono text-zinc-900">
                                    <strong>48-Hour Inspection Window Active</strong>
                                    <div class="text-[11px] text-zinc-600">Buyer inspects hardware against condition report.</div>
                                </div>
                                <CountdownLabel Deadline="@order.InspectionDeadline" Prefix="" TextClass="text-zinc-900 font-bold" OnExpired="RefreshCurrentOrder" />
                            </div>
                        }

                        <!-- Escrow Flow Contextual Actions -->
                        <div class="pt-2 border-t border-zinc-100 space-y-4">
                            <div class="flex items-center justify-between">
                                <h3 class="font-mono text-xs uppercase tracking-wider text-zinc-500">Available Actions</h3>
                                @if (_activeAction != null)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-zinc-600">
                                        <svg class="animate-spin w-3 h-3 text-zinc-800" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                        </svg>
                                        Processing action...
                                    </span>
                                }
                            </div>

                            <!-- In-Place Contextual Feedback -->
                            @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
                            {
                                <div class="p-3 rounded-sm border text-xs font-mono flex items-center justify-between animate-in @(_isError ? "bg-red-50 text-red-900 border-red-200" : "bg-emerald-50 text-emerald-900 border-emerald-200")">
                                    <div class="flex items-center gap-2">
                                        @if (_isError)
                                        {
                                            <span class="font-bold">✕</span>
                                        }
                                        else
                                        {
                                            <span class="font-bold text-emerald-700">✓</span>
                                        }
                                        <span>@_feedbackMessage</span>
                                    </div>
                                    <button type="button" @onclick="() => _feedbackMessage = null" class="font-bold px-1.5 text-xs hover:opacity-75">✕</button>
                                </div>
                            }

                            @if (order.Status == OrderStatus.Reserved)
                            {
                                @* STATE: RESERVED *@
                                @if (isBuyer)
                                {
                                    <div class="space-y-3">
                                        <p class="text-xs text-zinc-600">
                                            The item is reserved for you. Submit payment to hold funds securely in escrow.
                                        </p>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <button type="button"
                                                    @onclick="HandleSimulatePayment"
                                                    disabled="@(_activeAction != null)"
                                                    class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 disabled:bg-zinc-700 text-white text-xs font-semibold rounded-sm transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs">
                                                @if (_activeAction == "pay")
                                                {
                                                    <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                    </svg>
                                                    <span>Locking Funds in Escrow...</span>
                                                }
                                                else
                                                {
                                                    <span>Pay @AppConfig.FormatPrice(order.Price) to Escrow</span>
                                                }
                                            </button>

                                            <button type="button"
                                                    @onclick="HandleCancelOrder"
                                                    disabled="@(_activeAction != null)"
                                                    class="px-3 py-2 border border-zinc-300 text-zinc-700 text-xs font-medium rounded-sm hover:bg-zinc-50 transition-colors flex items-center gap-1.5 cursor-pointer">
                                                @if (_activeAction == "cancel")
                                                {
                                                    <svg class="animate-spin w-3.5 h-3.5 text-zinc-700" fill="none" viewBox="0 0 24 24">
                                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                    </svg>
                                                    <span>Cancelling...</span>
                                                }
                                                else
                                                {
                                                    <span>Cancel Reservation</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-xs text-zinc-600 font-mono">
                                        Waiting for the buyer to submit payment within the 24-hour reservation window.
                                    </p>
                                }
                            }
                            else if (order.Status == OrderStatus.Paid)
                            {
                                @* STATE: PAID (HELD) *@
                                @if (isSeller)
                                {
                                    <div class="space-y-3">
                                        <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-mono">
                                            ✓ Payment of @AppConfig.FormatPrice(order.Price) is secured in platform escrow. Safe to hand over or dispatch item.
                                        </div>
                                        <button type="button"
                                                @onclick="HandleMarkHandedOver"
                                                disabled="@(_activeAction != null)"
                                                class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 disabled:bg-zinc-700 text-white text-xs font-semibold rounded-sm transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs">
                                            @if (_activeAction == "ship")
                                            {
                                                <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                </svg>
                                                <span>Updating Order Status...</span>
                                            }
                                            else
                                            {
                                                <span>Mark Handed Over / Shipped</span>
                                            }
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-3">
                                        <div class="p-3 bg-zinc-50 border border-zinc-200 text-zinc-700 text-xs font-mono">
                                            Your payment of @AppConfig.FormatPrice(order.Price) is secured in escrow. The seller has 72 hours to hand over or ship the item.
                                        </div>
                                        @if (order.IsDispatchOverdue)
                                        {
                                            <div class="flex flex-wrap items-center gap-2">
                                                <button type="button"
                                                        @onclick="HandleClaimUnresponsiveSellerRefund"
                                                        disabled="@(_activeAction != null)"
                                                        class="px-4 py-2 bg-red-700 hover:bg-red-800 disabled:bg-red-900 text-white text-xs font-semibold rounded-sm transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs">
                                                    @if (_activeAction == "refund")
                                                    {
                                                        <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                        </svg>
                                                        <span>Refunding Escrow...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Claim Full Refund (Seller Unresponsive)</span>
                                                    }
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else if (order.Status == OrderStatus.HandedOverOrShipped)
                            {
                                @* STATE: HANDED OVER / SHIPPED (INSPECTION WINDOW) *@
                                @if (isBuyer)
                                {
                                    <div class="space-y-3">
                                        <p class="text-xs text-zinc-600">
                                            You have the item in your possession. Check each item against the verified condition report.
                                        </p>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <button type="button"
                                                    @onclick="HandleConfirmInspection"
                                                    disabled="@(_activeAction != null)"
                                                    class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 disabled:bg-zinc-700 text-white text-xs font-semibold rounded-sm transition-colors flex items-center gap-1.5 cursor-pointer shadow-xs">
                                                @if (_activeAction == "release")
                                                {
                                                    <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                    </svg>
                                                    <span>Releasing Escrow Payout...</span>
                                                }
                                                else
                                                {
                                                    <span>Confirm Condition &amp; Release Funds to Seller</span>
                                                }
                                            </button>

                                            <button type="button"
                                                    @onclick="() => _showDisputeModal = true"
                                                    disabled="@(_activeAction != null)"
                                                    class="px-3 py-2 border border-red-300 text-red-700 text-xs font-medium rounded-sm hover:bg-red-50 transition-colors cursor-pointer">
                                                Open Dispute
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-2">
                                        <p class="text-xs text-zinc-600 font-mono">
                                            The buyer is currently in the 48-hour inspection period. Funds will be released automatically if no dispute is filed.
                                        </p>
                                    </div>
                                }
                            }
                            else if (order.Status == OrderStatus.Disputed)
                            {
                                @* STATE: DISPUTED *@
                                <div class="bg-amber-50 border border-amber-300 rounded-sm p-4 space-y-2 text-xs">
                                    <div class="font-mono font-bold text-amber-950 uppercase">Active Dispute Under Review</div>
                                    @if (activeDispute != null)
                                    {
                                        <div class="text-zinc-800 space-y-1">
                                            <div><strong>Reason:</strong> @activeDispute.Reason</div>
                                            <div><strong>Evidence Notes:</strong> @activeDispute.EvidenceNotes</div>
                                            <div class="text-[11px] text-zinc-500 font-mono">Filed on @activeDispute.CreatedDate.ToString("MMM dd, yyyy HH:mm") UTC</div>
                                        </div>
                                    }
                                    <p class="text-zinc-600">
                                        Escrow funds are frozen. Platform administrators will review both parties' statements on the Admin page to issue a refund, payout, or partial settlement.
                                    </p>
                                </div>
                            }
                            else if (order.Status == OrderStatus.Resolved)
                            {
                                @* STATE: RESOLVED *@
                                <div class="bg-zinc-100 border border-zinc-300 rounded-sm p-4 text-xs space-y-1 font-mono">
                                    <div class="font-bold text-zinc-900">Dispute Resolved</div>
                                    @if (activeDispute != null)
                                    {
                                        <div>Resolution: <strong class="text-zinc-900">@activeDispute.Status.ToString()</strong></div>
                                        @if (activeDispute.PartialRefundAmount.HasValue)
                                        {
                                            <div>Partial Refund Amount: <strong>@AppConfig.FormatPrice(activeDispute.PartialRefundAmount.Value)</strong></div>
                                        }
                                        <div>Admin Notes: @activeDispute.AdminNote</div>
                                    }
                                </div>
                            }
                            else if (order.Status == OrderStatus.Released)
                            {
                                @* STATE: RELEASED (COMPLETED ESCROW) *@
                                <div class="p-3 bg-zinc-100 border border-zinc-200 rounded-sm text-xs font-mono text-zinc-800">
                                    ✓ Escrow transaction concluded successfully. Funds released to seller on @order.ReleasedDate?.ToString("MMM dd, yyyy").
                                </div>
                            }
                        </div>

                        <!-- Meetup Coordination Section (for Meetup delivery) -->
                        @if (order.DeliveryMethod == DeliveryMethod.Meetup)
                        {
                            <div class="border border-zinc-200 rounded-sm p-4 bg-zinc-50/50 space-y-3 text-xs">
                                <div class="flex items-center justify-between border-b border-zinc-200 pb-2">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs uppercase font-bold text-zinc-900">Meetup Coordination &amp; Venue</span>
                                        @if (order.IsMeetupAgreed)
                                        {
                                            <span class="px-2 py-0.5 text-[10px] font-mono bg-emerald-100 text-emerald-800 font-semibold rounded-sm">Agreed by Both</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 text-[10px] font-mono bg-amber-100 text-amber-800 font-semibold rounded-sm">Pending Agreement</span>
                                        }
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div class="p-3 bg-white border border-zinc-200 rounded-sm space-y-1">
                                        <span class="font-mono text-[10px] uppercase text-zinc-400 block">Proposed / Agreed Venue</span>
                                        <div class="font-medium text-zinc-900">
                                            @(string.IsNullOrWhiteSpace(order.MeetupLocation) ? "No location proposed yet" : order.MeetupLocation)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(order.MeetupTime))
                                        {
                                            <div class="text-[11px] text-zinc-600 font-mono">Target: @order.MeetupTime</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(order.MeetupNotes))
                                        {
                                            <div class="text-[11px] text-zinc-500 italic mt-1">"@order.MeetupNotes"</div>
                                        }
                                    </div>

                                    <div class="p-3 bg-white border border-zinc-200 rounded-sm space-y-2">
                                        <span class="font-mono text-[10px] uppercase text-zinc-400 block">Mutual Confirmation Status</span>
                                        <div class="space-y-1 text-xs font-mono">
                                            <div class="flex items-center gap-1.5 @(order.MeetupConfirmedByBuyer ? "text-emerald-700 font-medium" : "text-zinc-400")">
                                                <span>@(order.MeetupConfirmedByBuyer ? "✓" : "○")</span>
                                                <span>Buyer: @(order.MeetupConfirmedByBuyer ? "Confirmed" : "Pending agreement")</span>
                                            </div>
                                            <div class="flex items-center gap-1.5 @(order.MeetupConfirmedBySeller ? "text-emerald-700 font-medium" : "text-zinc-400")">
                                                <span>@(order.MeetupConfirmedBySeller ? "✓" : "○")</span>
                                                <span>Seller: @(order.MeetupConfirmedBySeller ? "Confirmed" : "Pending agreement")</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (order.Status == OrderStatus.Reserved || order.Status == OrderStatus.Paid)
                                {
                                    <div class="pt-2 border-t border-zinc-200 space-y-3">
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs font-semibold text-zinc-800">Propose or Update Meetup Details:</span>
                                            @if (!order.IsMeetupAgreed && !string.IsNullOrWhiteSpace(order.MeetupLocation))
                                            {
                                                var canConfirm = (isBuyer && !order.MeetupConfirmedByBuyer) || (isSeller && !order.MeetupConfirmedBySeller);
                                                if (canConfirm)
                                                {
                                                    <button type="button" @onclick="HandleConfirmMeetup" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium rounded-sm transition-colors cursor-pointer">
                                                        ✓ Agree to Proposed Venue
                                                    </button>
                                                }
                                            }
                                        </div>

                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                                            <div>
                                                <label class="block text-[11px] font-mono text-zinc-600 mb-0.5">Location / Venue</label>
                                                <input type="text" @bind="_meetupLocationInput" placeholder="e.g. 2nd Floor Cafe / Mall Lobby" class="w-full bg-white border border-zinc-200 rounded-sm p-1.5 text-xs text-zinc-900" />
                                            </div>
                                            <div>
                                                <label class="block text-[11px] font-mono text-zinc-600 mb-0.5">Target Date &amp; Time</label>
                                                <input type="text" @bind="_meetupTimeInput" placeholder="e.g. Saturday 3:00 PM" class="w-full bg-white border border-zinc-200 rounded-sm p-1.5 text-xs text-zinc-900" />
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-[11px] font-mono text-zinc-600 mb-0.5">Special Instructions / Landmarks</label>
                                            <input type="text" @bind="_meetupNotesInput" placeholder="e.g. Near main entrance, testing power bank ready" class="w-full bg-white border border-zinc-200 rounded-sm p-1.5 text-xs text-zinc-900" />
                                        </div>
                                        <button type="button" @onclick="HandleProposeMeetup" disabled="@(_activeAction == "meetup")" class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium rounded-sm transition-colors cursor-pointer">
                                            Save &amp; Propose Meetup Details
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Shipping / Tracking Section (for Shipping delivery) -->
                        @if (order.DeliveryMethod == DeliveryMethod.Shipping)
                        {
                            <div class="border border-zinc-200 rounded-sm p-4 bg-zinc-50/50 space-y-3 text-xs">
                                <div class="flex items-center justify-between border-b border-zinc-200 pb-2">
                                    <span class="font-mono text-xs uppercase font-bold text-zinc-900">Courier Shipping Details</span>
                                    @if (!string.IsNullOrWhiteSpace(order.TrackingNumber))
                                    {
                                        <span class="px-2 py-0.5 text-[10px] font-mono bg-blue-100 text-blue-800 font-semibold rounded-sm">Tracking Assigned</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 text-[10px] font-mono bg-zinc-200 text-zinc-700 font-semibold rounded-sm">Awaiting Tracking</span>
                                    }
                                </div>

                                <div class="p-3 bg-white border border-zinc-200 rounded-sm flex items-center justify-between">
                                    <div>
                                        <span class="font-mono text-[10px] uppercase text-zinc-400 block">Courier</span>
                                        <div class="font-medium text-zinc-900">@(string.IsNullOrWhiteSpace(order.CourierName) ? "Not specified" : order.CourierName)</div>
                                    </div>
                                    <div class="text-right">
                                        <span class="font-mono text-[10px] uppercase text-zinc-400 block">Tracking / Reference #</span>
                                        <div class="font-mono font-bold text-zinc-900">@(string.IsNullOrWhiteSpace(order.TrackingNumber) ? "Pending dispatch" : order.TrackingNumber)</div>
                                    </div>
                                </div>

                                @if (isSeller && (order.Status == OrderStatus.Paid || order.Status == OrderStatus.HandedOverOrShipped))
                                {
                                    <div class="pt-2 border-t border-zinc-200 space-y-2">
                                        <span class="text-xs font-semibold text-zinc-800">Update Tracking Information:</span>
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                            <div>
                                                <label class="block text-[11px] font-mono text-zinc-600 mb-0.5">Courier Name</label>
                                                <input type="text" @bind="_shippingCourierInput" placeholder="e.g. LBC Express, J&T, Grab" class="w-full bg-white border border-zinc-200 rounded-sm p-1.5 text-xs text-zinc-900" />
                                            </div>
                                            <div>
                                                <label class="block text-[11px] font-mono text-zinc-600 mb-0.5">Tracking Number</label>
                                                <input type="text" @bind="_shippingTrackingInput" placeholder="e.g. 1748-9320-XXXX" class="w-full bg-white border border-zinc-200 rounded-sm p-1.5 text-xs text-zinc-900" />
                                            </div>
                                        </div>
                                        <button type="button" @onclick="HandleSaveShippingDetails" disabled="@(_activeAction == "shipping")" class="px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium rounded-sm transition-colors cursor-pointer">
                                            Save Tracking Info
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Order Communication & Coordination Thread -->
                        <div class="border border-zinc-200 rounded-sm p-4 bg-white space-y-3">
                            <div class="flex items-center justify-between border-b border-zinc-100 pb-2">
                                <span class="font-mono text-xs uppercase font-bold text-zinc-900">Order Communication &amp; Coordination Log</span>
                                <span class="text-[11px] font-mono text-zinc-400">@order.Messages.Count note(s)</span>
                            </div>

                            <div class="max-h-60 overflow-y-auto space-y-2 text-xs pr-1">
                                @if (order.Messages.Count == 0)
                                {
                                    <div class="text-zinc-400 italic text-center py-4 font-mono text-[11px]">No messages yet. Send a note below to coordinate.</div>
                                }
                                else
                                {
                                    @foreach (var msg in order.Messages)
                                    {
                                        var isMe = msg.SenderId == CurrentUserService.UserId;
                                        <div class="p-2.5 rounded-sm @(msg.IsSystem ? "bg-zinc-100 text-zinc-600 font-mono text-[11px]" : isMe ? "bg-zinc-900 text-white ml-8" : "bg-zinc-100 text-zinc-800 mr-8")">
                                            <div class="flex items-center justify-between gap-2 text-[10px] opacity-75 mb-1 font-mono">
                                                <span>@msg.SenderName @(msg.IsSystem ? "(System)" : "")</span>
                                                <span>@msg.Timestamp.ToString("MMM dd HH:mm")</span>
                                            </div>
                                            <div class="break-words">@msg.Content</div>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="flex items-center gap-2 pt-2 border-t border-zinc-100">
                                <input type="text" @bind="_newOrderMessage" @bind:event="oninput" @onkeydown="@(async e => { if (e.Key == "Enter") await HandleSendOrderMessage(); })" placeholder="Send a message or handover update..." class="flex-1 bg-zinc-50 border border-zinc-200 rounded-sm p-2 text-xs text-zinc-900" />
                                <button type="button" @onclick="HandleSendOrderMessage" disabled="@(string.IsNullOrWhiteSpace(_newOrderMessage) || _activeAction == "msg")" class="px-4 py-2 bg-zinc-900 hover:bg-zinc-800 disabled:bg-zinc-300 text-white text-xs font-semibold rounded-sm transition-colors cursor-pointer">
                                    Send
                                </button>
                            </div>
                        </div>

                        <!-- Post-Completion Review Section -->
                        @if (order.Status == OrderStatus.Released || order.Status == OrderStatus.Resolved)
                        {
                            <div class="pt-4 border-t border-zinc-100 space-y-3">
                                <h3 class="font-mono text-xs uppercase tracking-wider text-zinc-500">Verified Transaction Review</h3>
                                @if (ExistingReview != null)
                                {
                                    <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-sm text-xs space-y-1">
                                        <div class="flex items-center gap-1 text-zinc-900 font-mono font-bold">
                                            @for (int s = 1; s <= ExistingReview.Rating; s++)
                                            {
                                                <span>★</span>
                                            }
                                            <span class="text-zinc-500 font-normal ml-1">(@ExistingReview.Rating / 5)</span>
                                        </div>
                                        <p class="text-zinc-700 italic">"@ExistingReview.Comment"</p>
                                        <div class="text-[10px] text-zinc-400 font-mono">Submitted on @ExistingReview.CreatedDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-zinc-50 border border-zinc-200 rounded-sm p-4 space-y-3 text-xs">
                                        <p class="text-zinc-600">
                                            Leave feedback for @(counterparty?.DisplayName ?? "your trade partner"). This contributes directly to their seller reliability record.
                                        </p>
                                        <div class="flex items-center gap-2 font-mono">
                                            <span class="text-zinc-500">Rating:</span>
                                            @for (int star = 1; star <= 5; star++)
                                            {
                                                var val = star;
                                                <button type="button" @onclick="() => _newReviewRating = val" class="text-base transition-colors @(_newReviewRating >= val ? "text-zinc-900" : "text-zinc-300")">
                                                    ★
                                                </button>
                                            }
                                            <span class="text-zinc-600 text-xs font-bold ml-1">@_newReviewRating / 5</span>
                                        </div>
                                        <textarea rows="2" @bind="_newReviewComment" placeholder="Write an honest comment regarding condition accuracy and handover promptness..." class="w-full bg-white border border-zinc-200 rounded-sm p-2 text-xs text-zinc-800"></textarea>
                                        <button type="button" @onclick="HandleSubmitReview" disabled="@(_activeAction == "review")" class="px-4 py-1.5 bg-zinc-900 text-white text-xs font-medium rounded-sm hover:bg-zinc-800 disabled:bg-zinc-700 transition-colors flex items-center gap-1.5 cursor-pointer">
                                            @if (_activeAction == "review")
                                            {
                                                <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                                                </svg>
                                                <span>Submitting...</span>
                                            }
                                            else
                                            {
                                                <span>Submit Review</span>
                                            }
                                        </button>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Administrator Override Tools (Visible exclusively to Admins) -->
                        @if (CurrentUserService.IsAdmin)
                        {
                            <div class="border border-zinc-200 rounded-sm p-4 bg-zinc-50/50 space-y-2 text-xs font-mono">
                                <div class="flex items-center justify-between border-b border-zinc-200 pb-1.5">
                                    <span class="font-bold uppercase text-zinc-900">Admin Timer Overrides</span>
                                    <span class="text-[10px] text-zinc-500">Administrator access only</span>
                                </div>
                                <p class="text-[11px] text-zinc-500 font-sans">
                                    Administrative controls to expire active escrow windows for testing and dispute resolution. Regular users do not see this panel and must wait for timer expiration.
                                </p>
                                <div class="flex flex-wrap items-center gap-2 pt-1">
                                    @if (order.Status == OrderStatus.Reserved)
                                    {
                                        <button type="button"
                                                @onclick="HandleSimulateExpireReservation"
                                                disabled="@(_activeAction != null)"
                                                class="px-3 py-1.5 border border-zinc-300 bg-white hover:bg-zinc-100 rounded-sm text-zinc-800 text-xs font-mono cursor-pointer">
                                            Expire Reservation Window
                                        </button>
                                    }
                                    else if (order.Status == OrderStatus.Paid)
                                    {
                                        <button type="button"
                                                @onclick="HandleSimulateExpireDispatchWindow"
                                                disabled="@(_activeAction != null)"
                                                class="px-3 py-1.5 border border-zinc-300 bg-white hover:bg-zinc-100 rounded-sm text-zinc-800 text-xs font-mono cursor-pointer">
                                            Expire 72h Dispatch Window
                                        </button>
                                    }
                                    else if (order.Status == OrderStatus.HandedOverOrShipped)
                                    {
                                        <button type="button"
                                                @onclick="HandleSimulateExpireInspection"
                                                disabled="@(_activeAction != null)"
                                                class="px-3 py-1.5 border border-zinc-300 bg-white hover:bg-zinc-100 rounded-sm text-zinc-800 text-xs font-mono cursor-pointer">
                                            Expire 48h Inspection Window
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-zinc-400 text-[11px]">No active timer to override in state @order.Status.</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Open Dispute Modal -->
    @if (_showDisputeModal && _selectedOrder != null)
    {
        <div class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
            <div class="bg-white border border-zinc-300 rounded-sm max-w-lg w-full p-6 space-y-4">
                <div class="flex items-center justify-between border-b border-zinc-200 pb-3">
                    <h3 class="text-xs font-semibold uppercase tracking-wider font-mono text-zinc-900">
                        Open Inspection Dispute
                    </h3>
                    <button type="button" @onclick="() => _showDisputeModal = false" class="text-zinc-400 hover:text-zinc-700">✕</button>
                </div>

                <p class="text-xs text-zinc-600">
                    Disputes freeze platform escrow payouts. Specify which checks from the condition report failed or which undisclosed defects were discovered.
                </p>

                <div class="space-y-3 text-xs">
                    <div>
                        <label class="font-mono text-zinc-700 block mb-1">Dispute Reason *</label>
                        <input type="text" @bind="_disputeReason" placeholder="e.g. Left stick drifts noticeably, or disc drive will not read discs" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm p-2 text-zinc-900" />
                    </div>
                    <div>
                        <label class="font-mono text-zinc-700 block mb-1">Evidence &amp; Diagnostic Details *</label>
                        <textarea rows="4" @bind="_disputeEvidenceNotes" placeholder="Describe diagnostic results and test steps conducted during your 48-hour window..." class="w-full bg-zinc-50 border border-zinc-200 rounded-sm p-2 text-zinc-900"></textarea>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-3 border-t border-zinc-100">
                    <button type="button" @onclick="() => _showDisputeModal = false" disabled="@(_activeAction == "dispute")" class="px-3 py-1.5 border border-zinc-200 text-xs rounded-sm">Cancel</button>
                    <button type="button" @onclick="HandleSubmitDispute" disabled="@(_activeAction == "dispute")" class="px-4 py-1.5 bg-red-700 hover:bg-red-800 disabled:bg-red-900 text-white text-xs font-semibold rounded-sm transition-colors flex items-center gap-1.5 cursor-pointer">
                        @if (_activeAction == "dispute")
                        {
                            <svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                            <span>Freezing Escrow...</span>
                        }
                        else
                        {
                            <span>Submit Dispute &amp; Freeze Escrow</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Order> _orders = new();
    private Order? _selectedOrder;
    private string _selectedTab = "All Orders";
    private string? _feedbackMessage;
    private bool _isError;

    // Meetup & Shipping inputs
    private string _meetupLocationInput = string.Empty;
    private string _meetupTimeInput = string.Empty;
    private string _meetupNotesInput = string.Empty;
    private string _shippingCourierInput = string.Empty;
    private string _shippingTrackingInput = string.Empty;
    private string _newOrderMessage = string.Empty;

    // Review state
    private int _newReviewRating = 5;
    private string _newReviewComment = string.Empty;
    private Review? ExistingReview => _selectedOrder != null && CurrentUserService.IsSignedIn
        ? OrderService.GetReviewForOrder(_selectedOrder.Id, CurrentUserService.UserId)
        : null;

    // Dispute modal state
    private bool _showDisputeModal = false;
    private string _disputeReason = string.Empty;
    private string _disputeEvidenceNotes = string.Empty;

    private List<Order> FilteredOrders => _selectedTab switch
    {
        "Buying" => _orders.Where(o => o.BuyerId == CurrentUserService.UserId).ToList(),
        "Selling" => _orders.Where(o => o.SellerId == CurrentUserService.UserId).ToList(),
        "Active Escrow" => _orders.Where(o => o.Status == OrderStatus.Reserved || o.Status == OrderStatus.Paid || o.Status == OrderStatus.HandedOverOrShipped || o.Status == OrderStatus.Disputed).ToList(),
        "Completed" => _orders.Where(o => o.Status == OrderStatus.Released || o.Status == OrderStatus.Resolved).ToList(),
        _ => _orders
    };

    protected override void OnInitialized()
    {
        LoadOrders();
    }

    private void LoadOrders()
    {
        if (CurrentUserService.IsSignedIn)
        {
            _orders = OrderService.GetOrdersForUser(CurrentUserService.UserId).ToList();
            if (_selectedOrder != null)
            {
                var refreshed = _orders.FirstOrDefault(o => o.Id == _selectedOrder.Id);
                if (refreshed != null)
                {
                    SelectOrder(refreshed);
                }
                else
                {
                    var first = _orders.FirstOrDefault();
                    if (first != null) SelectOrder(first);
                    else _selectedOrder = null;
                }
            }
            else if (_orders.Count > 0)
            {
                SelectOrder(_orders.First());
            }
        }
    }

    private void SetTab(string tab)
    {
        _selectedTab = tab;
        if (tab != "My Offers")
        {
            var filtered = FilteredOrders;
            if (filtered.Count > 0 && (_selectedOrder == null || !filtered.Any(o => o.Id == _selectedOrder.Id)))
            {
                SelectOrder(filtered.First());
            }
        }
    }

    private void SelectOrder(Order order)
    {
        _selectedOrder = order;
        _newReviewRating = 5;
        _newReviewComment = string.Empty;
        _meetupLocationInput = order.MeetupLocation ?? string.Empty;
        _meetupTimeInput = order.MeetupTime ?? string.Empty;
        _meetupNotesInput = order.MeetupNotes ?? string.Empty;
        _shippingCourierInput = order.CourierName ?? string.Empty;
        _shippingTrackingInput = order.TrackingNumber ?? string.Empty;
        _newOrderMessage = string.Empty;
    }

    private void RefreshCurrentOrder()
    {
        LoadOrders();
        StateHasChanged();
    }

    private string? _activeAction = null;

    private async Task HandleSimulatePayment()
    {
        if (_selectedOrder == null) return;
        _activeAction = "pay";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(250);

        var result = OrderService.SimulatePayment(_selectedOrder.Id, CurrentUserService.UserId);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowSuccess(result.Message, "Payment Secured in Escrow");
        }
        else
        {
            ToastService.ShowError(result.Message, "Payment Failed");
        }

        LoadOrders();
    }

    private async Task HandleCancelOrder()
    {
        if (_selectedOrder == null) return;
        _activeAction = "cancel";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(200);

        var result = OrderService.CancelOrder(_selectedOrder.Id, CurrentUserService.UserId);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowInfo(result.Message, "Reservation Cancelled");
        }
        else
        {
            ToastService.ShowError(result.Message, "Action Failed");
        }

        LoadOrders();
    }

    private async Task HandleMarkHandedOver()
    {
        if (_selectedOrder == null) return;
        _activeAction = "ship";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(250);

        var result = OrderService.MarkHandedOverOrShipped(_selectedOrder.Id, CurrentUserService.UserId);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowSuccess(result.Message, "Handover Initiated");
        }
        else
        {
            ToastService.ShowError(result.Message, "Action Failed");
        }

        LoadOrders();
    }

    private async Task HandleConfirmInspection()
    {
        if (_selectedOrder == null) return;
        _activeAction = "release";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(250);

        var result = OrderService.ConfirmInspection(_selectedOrder.Id, CurrentUserService.UserId);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowSuccess(result.Message, "Escrow Funds Released");
        }
        else
        {
            ToastService.ShowError(result.Message, "Action Failed");
        }

        LoadOrders();
    }

    private async Task HandleSimulateExpireInspection()
    {
        if (_selectedOrder == null) return;
        _activeAction = "expireInspection";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(200);

        var result = OrderService.SimulateExpireInspectionWindow(_selectedOrder.Id);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowInfo(result.Message, "Inspection Window Expired");
        }
        else
        {
            ToastService.ShowError(result.Message);
        }

        LoadOrders();
    }

    private async Task HandleSimulateExpireReservation()
    {
        if (_selectedOrder == null) return;
        _activeAction = "expireReservation";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(200);

        var result = OrderService.SimulateExpireReservationWindow(_selectedOrder.Id);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowWarning(result.Message, "Reservation Expired");
        }
        else
        {
            ToastService.ShowError(result.Message);
        }

        LoadOrders();
    }

    private async Task HandleSimulateExpireDispatchWindow()
    {
        if (_selectedOrder == null) return;
        _activeAction = "expireDispatch";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(200);

        var result = OrderService.SimulateExpireDispatchWindow(_selectedOrder.Id);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowWarning(result.Message, "Dispatch Window Expired");
        }
        else
        {
            ToastService.ShowError(result.Message);
        }

        LoadOrders();
    }

    private async Task HandleClaimUnresponsiveSellerRefund()
    {
        if (_selectedOrder == null) return;
        _activeAction = "refund";
        _feedbackMessage = null;
        StateHasChanged();

        await Task.Delay(250);

        var result = OrderService.ClaimUnresponsiveSellerRefund(_selectedOrder.Id, CurrentUserService.UserId);
        _activeAction = null;
        _isError = !result.Success;
        _feedbackMessage = result.Message;

        if (result.Success)
        {
            ToastService.ShowSuccess(result.Message, "Escrow Refund Issued");
        }
        else
        {
            ToastService.ShowError(result.Message, "Refund Failed");
        }

        LoadOrders();
    }

