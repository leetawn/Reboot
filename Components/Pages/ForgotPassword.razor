@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Forgot password | @AppConfig.AppName</PageTitle>

<AuthCard Title="Account recovery"
          Subtitle="Enter your email to reset your password"
          ErrorMessage="@Error">
    @if (Submitted == "true")
    {
        <div class="space-y-6">
            <div class="p-3 bg-zinc-50 border border-zinc-200 rounded-md text-xs text-zinc-700 leading-relaxed">
                If an account exists with this email, a reset link has been sent. Please check your inbox and follow the instructions to set a new password.
            </div>

            @if (!string.IsNullOrWhiteSpace(DemoToken))
            {
                <div class="p-3 bg-amber-50 border border-amber-200 rounded-md text-xs text-amber-900 space-y-2 font-mono">
                    <div class="font-bold uppercase tracking-wider text-[10px]">Testing Reset Link</div>
                    <div class="break-all text-[11px]">Token: @DemoToken</div>
                    <div>
                        <a href="/reset-password?email=@Uri.EscapeDataString(Email ?? "")&token=@Uri.EscapeDataString(DemoToken)" class="underline font-bold text-amber-900 hover:text-amber-800">
                            Click here to proceed to Reset Password &rarr;
                        </a>
                    </div>
                </div>
            }

            <div class="pt-2">
                <a href="/login" class="inline-flex items-center justify-center w-full px-4 py-2 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium rounded-md transition-colors">
                    Back to sign in
                </a>
            </div>
        </div>
    }
    else
    {
        <form method="post" action="/auth/forgot-password" class="space-y-4">
            <FormField Id="email"
                       Name="email"
                       Label="Email address"
                       Type="email"
                       Required="true"
                       AutoFocus="true"
                       Placeholder="name@example.com" />

            <div class="flex items-center justify-between pt-6">
                <a href="/login" class="text-xs font-medium text-zinc-700 hover:text-zinc-900 transition-colors">
                    Back to sign in
                </a>
                <button type="submit" class="px-6 py-2 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium rounded-md transition-colors shadow-none">
                    Next
                </button>
            </div>
        </form>
    }
</AuthCard>

@code {
    [SupplyParameterFromQuery] public string? Submitted { get; set; }
    [SupplyParameterFromQuery] public string? DemoToken { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
