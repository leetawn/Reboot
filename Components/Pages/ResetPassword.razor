@page "/reset-password"
@attribute [AllowAnonymous]

<PageTitle>Reset password | @AppConfig.AppName</PageTitle>

<AuthCard Title="Reset password"
          Subtitle="Create a new, strong password for your account"
          ErrorMessage="@Error">
    <form method="post" action="/auth/reset-password" class="space-y-4">
        <input type="hidden" name="email" value="@Email" />
        <input type="hidden" name="token" value="@Token" />

        <div class="space-y-1.5">
            <label for="newPassword" class="block text-xs font-medium text-zinc-700">
                New password <span class="text-zinc-400">*</span>
            </label>
            <input id="newPassword"
                   name="newPassword"
                   type="password"
                   required
                   autofocus
                   class="w-full px-3 py-2 text-sm bg-white border border-[#dadce0] rounded-md transition-colors outline-none focus:border-zinc-900 focus:ring-2 focus:ring-zinc-200 text-zinc-900" />
        </div>

        <div class="space-y-1.5">
            <label for="confirmPassword" class="block text-xs font-medium text-zinc-700">
                Confirm new password <span class="text-zinc-400">*</span>
            </label>
            <input id="confirmPassword"
                   name="confirmPassword"
                   type="password"
                   required
                   class="w-full px-3 py-2 text-sm bg-white border border-[#dadce0] rounded-md transition-colors outline-none focus:border-zinc-900 focus:ring-2 focus:ring-zinc-200 text-zinc-900" />
        </div>

        <p class="text-[11px] text-zinc-500">
            Use 8 or more characters with a mix of letters and numbers.
        </p>

        <div class="flex items-center gap-2 pt-1">
            <input id="showResetPassword"
                   type="checkbox"
                   onchange="const t = this.checked ? 'text' : 'password'; document.getElementById('newPassword').type = t; document.getElementById('confirmPassword').type = t;"
                   class="rounded border-zinc-300 text-zinc-900 focus:ring-zinc-900" />
            <label for="showResetPassword" class="text-xs text-zinc-600 cursor-pointer select-none">
                Show password
            </label>
        </div>

        <div class="flex items-center justify-between pt-6">
            <a href="/login" class="text-xs font-medium text-zinc-700 hover:text-zinc-900 transition-colors">
                Cancel
            </a>
            <button type="submit" class="px-6 py-2 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium rounded-md transition-colors shadow-none">
                Change password
            </button>
        </div>
    </form>
</AuthCard>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
