@page "/privacy"

<PageTitle>Privacy Policy | @AppConfig.AppName</PageTitle>

<div class="max-w-3xl mx-auto py-8">
    <div class="border-b border-zinc-200 pb-5 mb-8">
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl">Privacy Policy</h1>
        <p class="mt-1.5 text-sm text-zinc-600">Last updated: October 2026</p>
    </div>

    <div class="prose prose-zinc text-sm text-zinc-700 space-y-6 leading-relaxed">
        <section class="space-y-2">
            <h2 class="text-base font-semibold text-zinc-900">1. Information We Collect</h2>
            <p>
                We collect your name, email address, municipality location within Metro Cebu, transaction records, and optional verification documents submitted for verified badge eligibility.
            </p>
        </section>

        <section class="space-y-2">
            <h2 class="text-base font-semibold text-zinc-900">2. How We Use Your Information</h2>
            <p>
                Your information is used solely to maintain your account, process escrow payments and transactions, provide customer support, and detect fraud. We do not sell your personal data.
            </p>
        </section>

        <section class="space-y-2">
            <h2 class="text-base font-semibold text-zinc-900">3. Authentication &amp; Cookies</h2>
            <p>
                We use secure, HTTP-only session cookies to authenticate your session across visits. Cookies persist for up to 14 days and renew with active usage.
            </p>
        </section>

        <section class="space-y-2">
            <h2 class="text-base font-semibold text-zinc-900">4. Data Security</h2>
            <p>
                All passwords are cryptographically hashed using PBKDF2 with SHA-256 and salted. Sensitive transaction logs and dispute records are accessible only to platform administrators.
            </p>
        </section>
    </div>
</div>
