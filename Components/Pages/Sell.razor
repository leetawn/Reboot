@page "/sell"
@using Reboot.Models
@using Reboot.Services
@inject IListingService ListingService
@inject IUserService UserService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

<PageTitle>Sell | @AppConfig.AppName</PageTitle>

<PageHeader Title="List an item for sale"
            Description="Structured checklists ensure buyer trust and eliminate disputes. Every listing receives a calculated grade based on verified diagnostics." />

@if (!CurrentUserService.IsSignedIn)
{
    <div class="bg-white border border-zinc-200 rounded-md p-8 text-center max-w-md mx-auto my-8">
        <h3 class="text-sm font-semibold text-zinc-900">Sign in required</h3>
        <p class="text-xs text-zinc-600 mt-1 mb-4">
            You must be signed in to create and manage listings.
        </p>
        <a href="/login?returnUrl=/sell" class="inline-block px-4 py-2 bg-zinc-900 text-white text-xs font-medium rounded-md hover:bg-zinc-800 transition-colors">
            Sign in
        </a>
    </div>
}
else if (!CurrentUserService.IsVerified)
{
    <!-- Blocked message for unverified users -->
    <div class="bg-white border border-zinc-300 rounded-sm p-8 max-w-lg mx-auto my-8 space-y-4">
        <div class="flex items-center gap-2 text-zinc-900 font-mono text-xs uppercase tracking-wider font-semibold">
            <svg class="w-4 h-4 stroke-zinc-900" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>Identity Verification Required</span>
        </div>

        <h3 class="text-base font-bold text-zinc-900">
            Unverified accounts cannot publish listings
        </h3>

        <p class="text-xs text-zinc-600 leading-relaxed">
            Unlike anonymous classified sites, Reboot requires seller identity verification to protect buyers and keep dispute rates low. Unverified users can browse and purchase items, but you must complete simulated ID verification before listing.
        </p>

        <div class="p-3 bg-zinc-50 border border-zinc-200 rounded-sm text-xs font-mono text-zinc-700">
            Account: <strong class="text-zinc-900">@CurrentUserService.CurrentUser?.DisplayName</strong> (@CurrentUserService.CurrentUser?.Email)
            <br />Status: <span class="text-red-700 font-semibold">Not Verified</span>
        </div>

        @if (_isSimulatingVerification)
        {
            <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-mono">
                ✓ Identity verification simulated successfully. Refreshing privileges...
            </div>
        }
        else
        {
            <button type="button" @onclick="SimulateVerifyAccount" class="w-full py-2.5 px-4 bg-zinc-900 text-white text-xs font-medium rounded-sm hover:bg-zinc-800 transition-colors">
                Simulate ID Verification (Verify My Account)
            </button>
        }
    </div>
}
else
{
    <!-- Main Listing Creation Form -->
    <div class="max-w-3xl mx-auto space-y-8">
        <!-- Error / Warning Banner -->
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="p-3 bg-red-50 border border-red-200 text-red-900 text-xs font-mono rounded-sm">
                @_errorMessage
            </div>
        }

        <!-- Step 1: Category & Basics -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-4">
            <div class="border-b border-zinc-100 pb-3">
                <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 1 of 4</span>
                <h2 class="text-base font-semibold text-zinc-900">Basics &amp; Hardware Category</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Hardware Category *</label>
                    <select @bind="_listing.Category" @bind:after="OnCategoryChanged" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono">
                        @foreach (var cat in Enum.GetValues<ListingCategory>())
                        {
                            <option value="@cat">@cat.ToString()</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Brand / Manufacturer *</label>
                    <input type="text" @bind="_listing.Brand" placeholder="e.g. Sony, Nintendo, ASUS, Valve" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900" />
                </div>

                <div class="sm:col-span-2">
                    <label class="font-mono text-zinc-700 block mb-1">Listing Title *</label>
                    <input type="text" @bind="_listing.Title" placeholder="e.g. PlayStation 5 Disc Edition with 2 DualSense controllers" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900" />
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Serial Number (Optional)</label>
                    <input type="text" @bind="_listing.SerialNumber" placeholder="e.g. CFI-1218A-84920" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono" />
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Delivery Options</label>
                    <select @bind="_listing.MeetupOrShipping" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono">
                        <option value="@DeliveryOption.Both">Both (Meetup or Shipping)</option>
                        <option value="@DeliveryOption.Meetup">Meetup in Cebu Only</option>
                        <option value="@DeliveryOption.Shipping">Shipping Only</option>
                    </select>
                </div>

                <div class="sm:col-span-2">
                    <label class="font-mono text-zinc-700 block mb-1">Item Description &amp; Accessories Included *</label>
                    <textarea rows="4" @bind="_listing.Description" placeholder="Describe usage history, original cables, box, or included peripherals..." class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900"></textarea>
                </div>
            </div>
        </div>

        <!-- Step 2: Category Condition Checklist -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-4">
            <div class="border-b border-zinc-100 pb-3 flex items-baseline justify-between">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 2 of 4</span>
                    <h2 class="text-base font-semibold text-zinc-900">Structured Condition Checklist</h2>
                </div>
                <span class="font-mono text-xs text-zinc-500">
                    Category: @_listing.Category.ToString()
                </span>
            </div>

            <p class="text-xs text-zinc-600">
                Check off each diagnostic test honestly. Buyers inspect against this checklist upon receiving the item.
            </p>

            <div class="space-y-3">
                @for (int i = 0; i < _listing.ConditionReport.Checks.Count; i++)
                {
                    var index = i;
                    var check = _listing.ConditionReport.Checks[index];

                    <div class="p-3 border border-zinc-200 rounded-sm bg-zinc-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex-1">
                            <div class="font-medium text-xs text-zinc-900">
                                @check.Name
                            </div>
                            <input type="text"
                                   @bind="check.Notes"
                                   placeholder="Diagnostic notes (e.g. tested with 4K HDR, deadzone 4%)..."
                                   class="mt-1 w-full text-[11px] bg-white border border-zinc-200 rounded-sm px-2 py-1 text-zinc-700" />
                        </div>

                        <div class="flex items-center gap-2 font-mono text-xs flex-shrink-0">
                            <button type="button"
                                    @onclick="() => SetCheckPassed(index, true)"
                                    class="px-2.5 py-1 rounded-sm border transition-colors @(check.Passed ? "bg-zinc-900 text-white border-zinc-900 font-semibold" : "bg-white text-zinc-600 border-zinc-200")">
                                Pass
                            </button>
                            <button type="button"
                                    @onclick="() => SetCheckPassed(index, false)"
                                    class="px-2.5 py-1 rounded-sm border transition-colors @(!check.Passed ? "bg-red-700 text-white border-red-700 font-semibold" : "bg-white text-zinc-600 border-zinc-200")">
                                Fail
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Known defects free-text -->
            <div class="pt-3 border-t border-zinc-100">
                <label class="font-mono text-xs text-zinc-700 block mb-1">
                    Known Defects, Blemishes, or Cosmetic Wear
                </label>
                <textarea rows="2"
                          @bind="_listing.ConditionReport.KnownDefects"
                          @bind:event="oninput"
                          placeholder="Type 'None' if pristine, or describe scratches, battery wear, cosmetic marks..."
                          class="w-full text-xs bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900"></textarea>
                <p class="text-[11px] text-zinc-400 mt-1">
                    Keywords like "scuff", "hairline", "dent", or "for parts" influence the calculated grade.
                </p>
            </div>
        </div>

        <!-- Step 3: Grade Preview -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-3">
            <div class="border-b border-zinc-100 pb-3 flex items-baseline justify-between">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 3 of 4</span>
                    <h2 class="text-base font-semibold text-zinc-900">Calculated Item Grade</h2>
                </div>
                <span class="font-mono text-xs text-zinc-500">
                    Calculated Automatically
                </span>
            </div>

            <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-sm flex items-center justify-between gap-4">
                <div>
                    <div class="mb-1">
                        <GradeBadge Grade="@CurrentCalculatedGrade" ShowDescription="true" />
                    </div>
                    <p class="text-xs text-zinc-600 mt-1">
                        Grade is computed by documented platform rules from your condition checklist (@_listing.ConditionReport.PassedCount / @_listing.ConditionReport.TotalCount checks passed) and disclosed defect notes.
                    </p>
                </div>
            </div>
        </div>

        <!-- Step 4: Pricing & Warranty -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-4">
            <div class="border-b border-zinc-100 pb-3">
                <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 4 of 4</span>
                <h2 class="text-base font-semibold text-zinc-900">Pricing, Offers &amp; Warranty</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Listing Price (₱) *</label>
                    <input type="number" step="100" @bind="_listing.Price" placeholder="e.g. 24500" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono tabular-nums" />
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Minimum Offer (Optional, ₱)</label>
                    <input type="number" step="100" @bind="_listing.MinimumOffer" placeholder="Leave blank to disable offers" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono tabular-nums" />
                </div>

                <div class="sm:col-span-2">
                    <label class="font-mono text-zinc-700 block mb-1">Personal Seller Warranty Guarantee</label>
                    <select @bind="_selectedWarrantyDays" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono">
                        <option value="0">None (Platform standard 48-hour escrow inspection only)</option>
                        <option value="7">7 Days Seller Guarantee</option>
                        <option value="14">14 Days Seller Guarantee</option>
                        <option value="30">30 Days Seller Guarantee</option>
                        <option value="90">90 Days Seller Guarantee</option>
                    </select>
                </div>
            </div>

            <!-- Photos slot simulation -->
            <div class="pt-4 border-t border-zinc-100">
                <span class="font-mono text-xs text-zinc-700 block mb-2">Simulated Photo Verification Slots (Up to 4)</span>
                <div class="grid grid-cols-4 gap-3">
                    @for (int i = 0; i < 4; i++)
                    {
                        var slotIndex = i;
                        <div class="aspect-square bg-zinc-100 border border-zinc-200 rounded-sm flex flex-col items-center justify-center p-2 text-center text-zinc-400 font-mono text-[11px]">
                            <span>Slot @(slotIndex + 1)</span>
                            <span class="text-[9px] mt-1 opacity-75">Verified</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Publish Action Button -->
        <div class="flex items-center justify-end gap-3 pt-4">
            <a href="/browse" class="px-4 py-2 border border-zinc-200 text-xs font-medium text-zinc-700 rounded-sm hover:bg-zinc-50">Cancel</a>
            <button type="button" @onclick="HandlePublishListing" class="px-6 py-2.5 bg-zinc-900 text-white text-xs font-semibold rounded-sm hover:bg-zinc-800 transition-colors">
                Publish Verified Listing
            </button>
        </div>
    </div>
}

@code {
    private Listing _listing = new();
    private int _selectedWarrantyDays = 7;
    private bool _isSimulatingVerification = false;
    private string? _errorMessage;

    private ItemGrade CurrentCalculatedGrade => ListingService.CalculateGrade(_listing.ConditionReport);

    protected override void OnInitialized()
    {
        InitializeNewListing();
    }

    private void InitializeNewListing()
    {
        _listing = new Listing
        {
            Category = ListingCategory.Console,
            ConditionReport = new ConditionReport
            {
                KnownDefects = "None",
                Checks = ListingService.GetDefaultChecksForCategory(ListingCategory.Console)
            }
        };
    }

    private void OnCategoryChanged()
    {
        _listing.ConditionReport.Checks = ListingService.GetDefaultChecksForCategory(_listing.Category);
    }

    private void SetCheckPassed(int index, bool passed)
    {
        if (index >= 0 && index < _listing.ConditionReport.Checks.Count)
        {
            _listing.ConditionReport.Checks[index].Passed = passed;
        }
    }

    private void SimulateVerifyAccount()
    {
        if (CurrentUserService.CurrentUser != null)
        {
            _isSimulatingVerification = true;
            UserService.VerifyUser(CurrentUserService.UserId);
            CurrentUserService.CurrentUser.IsVerified = true;
            _isSimulatingVerification = false;
        }
    }

    private void HandlePublishListing()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_listing.Title))
        {
            _errorMessage = "Please enter a listing title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_listing.Brand))
        {
            _errorMessage = "Please specify the brand or manufacturer.";
            return;
        }

        if (_listing.Price <= 0)
        {
            _errorMessage = "Please enter a valid price greater than 0.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_listing.Description))
        {
            _errorMessage = "Please enter an item description.";
            return;
        }

        _listing.SellerId = CurrentUserService.UserId;
        _listing.WarrantyOffered = _selectedWarrantyDays > 0 ? _selectedWarrantyDays : null;
        _listing.Grade = CurrentCalculatedGrade;

        var created = ListingService.CreateListing(_listing);
        NavigationManager.NavigateTo($"/listing/{created.Id}");
    }
}
