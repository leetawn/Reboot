@page "/sell"
@using Reboot.Models
@using Reboot.Services
@inject IListingService ListingService
@inject IUserService UserService
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Sell | @AppConfig.AppName</PageTitle>

<PageHeader Title="List an item for sale"
            Description="Structured checklists ensure buyer trust and eliminate disputes. Every listing receives a calculated grade based on verified diagnostics." />

@if (!CurrentUserService.IsSignedIn)
{
    <div class="bg-white border border-zinc-200 rounded-md p-8 text-center max-w-md mx-auto my-8">
        <h3 class="text-sm font-semibold text-zinc-900">Sign in required</h3>
        <p class="text-xs text-zinc-600 mt-1 mb-4">
            You must be signed in to create and manage listings.
        </p>
        <a href="/login?returnUrl=/sell" class="inline-block px-4 py-2 bg-zinc-900 text-white text-xs font-medium rounded-md hover:bg-zinc-800 transition-colors">
            Sign in
        </a>
    </div>
}
else if (!CurrentUserService.IsVerified)
{
    <!-- Blocked message for unverified users -->
    <div class="bg-white border border-zinc-300 rounded-sm p-8 max-w-lg mx-auto my-8 space-y-4">
        <div class="flex items-center gap-2 text-zinc-900 font-mono text-xs uppercase tracking-wider font-semibold">
            <svg class="w-4 h-4 stroke-zinc-900" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>Identity Verification Required</span>
        </div>

        <h3 class="text-base font-bold text-zinc-900">
            Unverified accounts cannot publish listings
        </h3>

        <p class="text-xs text-zinc-600 leading-relaxed">
            Unlike anonymous classified sites, Reboot requires seller identity verification to protect buyers and keep dispute rates low. Unverified users can browse and purchase items, but you must complete simulated ID verification before listing.
        </p>

        <div class="p-3 bg-zinc-50 border border-zinc-200 rounded-sm text-xs font-mono text-zinc-700">
            Account: <strong class="text-zinc-900">@CurrentUserService.CurrentUser?.DisplayName</strong> (@CurrentUserService.CurrentUser?.Email)
            <br />Status: <span class="text-red-700 font-semibold">Not Verified</span>
        </div>

        @if (_isSimulatingVerification)
        {
            <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-mono flex items-center gap-2">
                <svg class="animate-spin w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                <span>Verifying identity credentials...</span>
            </div>
        }
        else
        {
            <button type="button" @onclick="SimulateVerifyAccount" class="w-full py-2.5 px-4 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium rounded-sm transition-colors cursor-pointer shadow-xs">
                Simulate ID Verification (Verify My Account)
            </button>
        }
    </div>
}
else
{
    <!-- Main Listing Creation Form -->
    <div class="max-w-3xl mx-auto space-y-8">
        <!-- Step 1: Category & Basics -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-4">
            <div class="border-b border-zinc-100 pb-3">
                <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 1 of 4</span>
                <h2 class="text-base font-semibold text-zinc-900">Basics &amp; Hardware Category</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Hardware Category *</label>
                    <select @bind="_listing.Category" @bind:after="OnCategoryChanged" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono">
                        @foreach (var cat in Enum.GetValues<ListingCategory>())
                        {
                            <option value="@cat">@cat.ToString()</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Brand / Manufacturer *</label>
                    <input type="text" @bind="_listing.Brand" placeholder="e.g. Sony, Nintendo, ASUS, Valve" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900" />
                </div>

                <div class="sm:col-span-2">
                    <label class="font-mono text-zinc-700 block mb-1">Listing Title *</label>
                    <input type="text" @bind="_listing.Title" placeholder="e.g. PlayStation 5 Disc Edition with 2 DualSense controllers" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900" />
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Serial Number (Optional)</label>
                    <input type="text" @bind="_listing.SerialNumber" placeholder="e.g. CFI-1218A-84920" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono" />
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Delivery Options</label>
                    <select @bind="_listing.MeetupOrShipping" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono">
                        <option value="@DeliveryOption.Both">Both (Meetup or Shipping)</option>
                        <option value="@DeliveryOption.Meetup">Meetup in Cebu Only</option>
                        <option value="@DeliveryOption.Shipping">Shipping Only</option>
                    </select>
                </div>

                <div class="sm:col-span-2">
                    <label class="font-mono text-zinc-700 block mb-1">Item Description &amp; Accessories Included *</label>
                    <textarea rows="4" @bind="_listing.Description" placeholder="Describe usage history, original cables, box, or included peripherals..." class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900"></textarea>
                </div>
            </div>
        </div>

        <!-- Step 2: Category Condition Checklist -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-4">
            <div class="border-b border-zinc-100 pb-3 flex items-baseline justify-between">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 2 of 4</span>
                    <h2 class="text-base font-semibold text-zinc-900">Structured Condition Checklist</h2>
                </div>
                <span class="font-mono text-xs text-zinc-500">
                    Category: @_listing.Category.ToString()
                </span>
            </div>

            <p class="text-xs text-zinc-600">
                Check off each diagnostic test honestly. Buyers inspect against this checklist upon receiving the item.
            </p>

            <div class="space-y-3">
                @for (int i = 0; i < _listing.ConditionReport.Checks.Count; i++)
                {
                    var index = i;
                    var check = _listing.ConditionReport.Checks[index];

                    <div class="p-3 border border-zinc-200 rounded-sm bg-zinc-50/50 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex-1">
                            <div class="font-medium text-xs text-zinc-900">
                                @check.Name
                            </div>
                            <input type="text"
                                   @bind="check.Notes"
                                   placeholder="Diagnostic notes (e.g. tested with 4K HDR, deadzone 4%)..."
                                   class="mt-1 w-full text-[11px] bg-white border border-zinc-200 rounded-sm px-2 py-1 text-zinc-700" />
                        </div>

                        <div class="flex items-center gap-2 font-mono text-xs flex-shrink-0">
                            <button type="button"
                                    @onclick="() => SetCheckPassed(index, true)"
                                    class="px-2.5 py-1 rounded-sm border transition-colors @(check.Passed ? "bg-zinc-900 text-white border-zinc-900 font-semibold" : "bg-white text-zinc-600 border-zinc-200")">
                                Pass
                            </button>
                            <button type="button"
                                    @onclick="() => SetCheckPassed(index, false)"
                                    class="px-2.5 py-1 rounded-sm border transition-colors @(!check.Passed ? "bg-red-700 text-white border-red-700 font-semibold" : "bg-white text-zinc-600 border-zinc-200")">
                                Fail
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Known defects free-text -->
            <div class="pt-3 border-t border-zinc-100">
                <label class="font-mono text-xs text-zinc-700 block mb-1">
                    Known Defects, Blemishes, or Cosmetic Wear
                </label>
                <textarea rows="2"
                          @bind="_listing.ConditionReport.KnownDefects"
                          @bind:event="oninput"
                          placeholder="Type 'None' if pristine, or describe scratches, battery wear, cosmetic marks..."
                          class="w-full text-xs bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900"></textarea>
                <p class="text-[11px] text-zinc-400 mt-1">
                    Keywords like "scuff", "hairline", "dent", or "for parts" influence the calculated grade.
                </p>
            </div>
        </div>

        <!-- Step 3: Grade Preview -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-3">
            <div class="border-b border-zinc-100 pb-3 flex items-baseline justify-between">
                <div>
                    <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 3 of 4</span>
                    <h2 class="text-base font-semibold text-zinc-900">Calculated Item Grade</h2>
                </div>
                <span class="font-mono text-xs text-zinc-500">
                    Calculated Automatically
                </span>
            </div>

            <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-sm flex items-center justify-between gap-4">
                <div>
                    <div class="mb-1">
                        <GradeBadge Grade="@CurrentCalculatedGrade" ShowDescription="true" />
                    </div>
                    <p class="text-xs text-zinc-600 mt-1">
                        Grade is computed by documented platform rules from your condition checklist (@_listing.ConditionReport.PassedCount / @_listing.ConditionReport.TotalCount checks passed) and disclosed defect notes.
                    </p>
                </div>
            </div>
        </div>

        <!-- Step 4: Pricing, Photos & Warranty -->
        <div class="bg-white border border-zinc-200 rounded-sm p-6 space-y-6">
            <div class="border-b border-zinc-100 pb-3">
                <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Step 4 of 4</span>
                <h2 class="text-base font-semibold text-zinc-900">Pricing, Photos &amp; Warranty</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Listing Price (₱) *</label>
                    <input type="number" step="100" @bind="_listing.Price" placeholder="e.g. 24500" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono tabular-nums" />
                </div>

                <div>
                    <label class="font-mono text-zinc-700 block mb-1">Minimum Offer (Optional, ₱)</label>
                    <input type="number" step="100" @bind="_listing.MinimumOffer" placeholder="Leave blank to disable offers" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono tabular-nums" />
                </div>

                <div class="sm:col-span-2">
                    <label class="font-mono text-zinc-700 block mb-1">Personal Seller Warranty Guarantee</label>
                    <select @bind="_selectedWarrantyDays" class="w-full bg-zinc-50 border border-zinc-200 rounded-sm px-3 py-2 text-zinc-900 font-mono">
                        <option value="0">None (Platform standard 48-hour escrow inspection only)</option>
                        <option value="7">7 Days Seller Guarantee</option>
                        <option value="14">14 Days Seller Guarantee</option>
                        <option value="30">30 Days Seller Guarantee</option>
                        <option value="90">90 Days Seller Guarantee</option>
                    </select>
                </div>
            </div>

            <!-- Real Photos Upload Section -->
            <div class="pt-4 border-t border-zinc-100 space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <span class="font-mono text-xs text-zinc-900 font-semibold block">Hardware Item Photos <span class="text-red-500">*</span></span>
                        <p class="text-[11px] text-zinc-500">Upload actual photos of your hardware from multiple angles. The first photo will be used as the listing cover.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-xs text-zinc-500 bg-zinc-100 border border-zinc-200 px-2 py-0.5 rounded-sm">
                            @_listing.Photos.Count / 6 photos
                        </span>
                        @if (_listing.Photos.Count < 6)
                        {
                            <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-medium rounded-sm transition-colors shadow-xs">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                                <span>Add Photos</span>
                                <InputFile OnChange="HandlePhotoSelected" multiple accept="image/png,image/jpeg,image/webp" class="hidden" />
                            </label>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_photoUploadError))
                {
                    <div class="p-2.5 bg-red-50 border border-red-200 text-red-700 text-xs rounded-sm">
                        @_photoUploadError
                    </div>
                }

                @if (_isUploadingPhotos)
                {
                    <div class="flex items-center gap-2 text-xs font-mono text-zinc-600 bg-zinc-50 border border-zinc-200 p-3 rounded-sm">
                        <svg class="animate-spin w-4 h-4 text-zinc-800" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Processing and attaching photos...</span>
                    </div>
                }

                <!-- Photo Previews Grid -->
                @if (_listing.Photos.Count > 0)
                {
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 pt-1">
                        @for (int i = 0; i < _listing.Photos.Count; i++)
                        {
                            var index = i;
                            var photoUrl = _listing.Photos[index];
                            var isCover = index == 0;

                            <div class="relative group bg-zinc-100 border @(isCover ? "border-zinc-900 ring-2 ring-zinc-900/10" : "border-zinc-200") rounded-sm overflow-hidden flex items-center justify-center" style="aspect-ratio: 1 / 1; width: 100%;">
                                <img src="@photoUrl" alt="Item photo @(index + 1)" style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />

                                <!-- Badges -->
                                @if (isCover)
                                {
                                    <span class="absolute top-1.5 left-1.5 bg-zinc-900 text-white text-[9px] font-mono uppercase px-1.5 py-0.5 rounded-xs font-semibold shadow-xs z-10">
                                        Cover Photo
                                    </span>
                                }

                                <!-- Overlay Action Buttons -->
                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between p-2 z-10">
                                    <div class="flex justify-end">
                                        <button type="button" @onclick="() => RemovePhoto(index)" title="Remove photo" class="p-1 bg-white/90 hover:bg-white text-zinc-800 hover:text-red-600 rounded-sm transition-colors shadow-xs">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>

                                    @if (!isCover)
                                    {
                                        <button type="button" @onclick="() => MakePhotoCover(index)" class="w-full py-1 bg-white/95 hover:bg-white text-zinc-900 text-[10px] font-mono uppercase tracking-wider rounded-xs font-semibold transition-colors shadow-xs">
                                            Set as Cover
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (_listing.Photos.Count < 6)
                        {
                            <label class="cursor-pointer bg-zinc-50 border-2 border-dashed border-zinc-200 hover:border-zinc-400 rounded-sm flex flex-col items-center justify-center p-3 text-center transition-colors group" style="aspect-ratio: 1 / 1; width: 100%;">
                                <svg class="w-6 h-6 text-zinc-400 group-hover:text-zinc-700 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 4v16m8-8H4" />
                                </svg>
                                <span class="font-mono text-[11px] text-zinc-600 group-hover:text-zinc-900 mt-1.5 font-medium">Add Photo</span>
                                <InputFile OnChange="HandlePhotoSelected" multiple accept="image/png,image/jpeg,image/webp" class="hidden" />
                            </label>
                        }
                    </div>
                }
                else
                {
                    <!-- Empty State Upload Box -->
                    <div class="p-8 border-2 border-dashed border-zinc-200 rounded-sm bg-zinc-50/50 hover:bg-zinc-50 text-center transition-colors">
                        <div class="max-w-xs mx-auto flex flex-col items-center">
                            <div class="w-12 h-12 rounded-full bg-zinc-100 flex items-center justify-center text-zinc-500 mb-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <span class="text-xs font-semibold text-zinc-900">No photos added yet</span>
                            <p class="text-[11px] text-zinc-500 mt-0.5 mb-4">Add clear photos showing screen, ports, serial number, and physical condition.</p>

                            <label class="cursor-pointer inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 text-white text-xs font-medium rounded-sm hover:bg-zinc-800 transition-colors shadow-xs">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                                <span>Choose Photos from Device</span>
                                <InputFile OnChange="HandlePhotoSelected" multiple accept="image/png,image/jpeg,image/webp" class="hidden" />
                            </label>
                        </div>
                    </div>
                }

                <!-- Option to add photo via URL -->
                <div class="pt-1">
                    @if (!_showUrlInput)
                    {
                        <button type="button" @onclick="() => _showUrlInput = true" class="text-[11px] font-mono text-zinc-500 hover:text-zinc-800 underline underline-offset-2">
                            + Or enter photo URL directly
                        </button>
                    }
                    else
                    {
                        <div class="flex items-center gap-2 mt-1">
                            <input type="url" @bind="_manualPhotoUrl" placeholder="https://example.com/hardware-photo.jpg" class="flex-1 text-xs bg-zinc-50 border border-zinc-200 rounded-sm px-2.5 py-1.5 text-zinc-800" />
                            <button type="button" @onclick="AddManualPhotoUrl" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-mono rounded-sm">
                                Add URL
                            </button>
                            <button type="button" @onclick="() => { _showUrlInput = false; _manualPhotoUrl = string.Empty; }" class="text-xs text-zinc-500 hover:text-zinc-700 px-2 py-1.5">
                                Cancel
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Publish Action Button with Loading Feedback -->
        <div class="flex items-center justify-end gap-3 pt-4">
            <a href="/browse" class="px-4 py-2 border border-zinc-200 text-xs font-medium text-zinc-700 rounded-sm hover:bg-zinc-50">Cancel</a>
            <button type="button"
                    @onclick="HandlePublishListing"
                    disabled="@_isPublishing"
                    class="px-6 py-2.5 bg-zinc-900 hover:bg-zinc-800 disabled:bg-zinc-700 text-white text-xs font-semibold rounded-sm transition-colors shadow-xs flex items-center gap-2 cursor-pointer">
                @if (_isPublishing)
                {
                    <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Publishing Listing...</span>
                }
                else
                {
                    <span>Publish Verified Listing</span>
                }
            </button>
        </div>
    </div>

    <!-- Missing Details Modal Pop-up -->
    @if (_showValidationModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs" @onclick="CloseValidationModal">
            <div class="bg-white border border-zinc-300 rounded-lg shadow-2xl max-w-md w-full overflow-hidden" @onclick:stopPropagation>
                <!-- Modal Header -->
                <div class="p-5 border-b border-zinc-100 flex items-start justify-between gap-3 bg-zinc-50/50">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-red-600 flex-shrink-0">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-zinc-900">Missing Listing Details</h3>
                            <p class="text-xs text-zinc-500 mt-0.5">Please provide the required information below to publish:</p>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseValidationModal" class="text-zinc-400 hover:text-zinc-700 p-1 rounded-sm transition-colors" aria-label="Close">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="p-5 space-y-3">
                    <p class="text-xs text-zinc-600">
                        Your listing couldn't be published because the following required details are missing:
                    </p>
                    <div class="p-3.5 bg-red-50 border border-red-200/80 rounded-md">
                        <ul class="space-y-2 text-xs text-red-900">
                            @foreach (var error in _validationErrors)
                            {
                                <li class="flex items-start gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 mt-1.5 flex-shrink-0"></span>
                                    <span class="font-medium">@error</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="px-5 py-3.5 bg-zinc-50 border-t border-zinc-100 flex items-center justify-end gap-2">
                    <button type="button" @onclick="CloseValidationModal" class="w-full sm:w-auto px-5 py-2 bg-zinc-900 text-white text-xs font-semibold rounded-md hover:bg-zinc-800 transition-colors shadow-xs">
                        Review &amp; Fix Details
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private Listing _listing = new();
    private int _selectedWarrantyDays = 7;
    private bool _isSimulatingVerification = false;
    private bool _showValidationModal = false;
    private List<string> _validationErrors = new();
    private bool _isUploadingPhotos = false;
    private string? _photoUploadError;
    private string _manualPhotoUrl = string.Empty;
    private bool _showUrlInput = false;

    private ItemGrade CurrentCalculatedGrade => ListingService.CalculateGrade(_listing.ConditionReport);

    protected override void OnInitialized()
    {
        InitializeNewListing();
    }

    private void InitializeNewListing()
    {
        _listing = new Listing
        {
            Category = ListingCategory.Console,
            ConditionReport = new ConditionReport
            {
                KnownDefects = "None",
                Checks = ListingService.GetDefaultChecksForCategory(ListingCategory.Console)
            }
        };
    }

    private void OnCategoryChanged()
    {
        _listing.ConditionReport.Checks = ListingService.GetDefaultChecksForCategory(_listing.Category);
    }

    private void SetCheckPassed(int index, bool passed)
    {
        if (index >= 0 && index < _listing.ConditionReport.Checks.Count)
        {
            _listing.ConditionReport.Checks[index].Passed = passed;
        }
    }

    private async Task SimulateVerifyAccount()
    {
        if (CurrentUserService.CurrentUser != null)
        {
            _isSimulatingVerification = true;
            StateHasChanged();
            await Task.Delay(350);

            UserService.VerifyUser(CurrentUserService.UserId);
            CurrentUserService.CurrentUser.IsVerified = true;
            _isSimulatingVerification = false;
            ToastService.ShowSuccess("Identity verification simulated successfully! You can now publish listings.", "Account Verified");
            StateHasChanged();
        }
    }

    private async Task HandlePhotoSelected(InputFileChangeEventArgs e)
    {
        _photoUploadError = null;
        _isUploadingPhotos = true;
        StateHasChanged();

        try
        {
            var files = e.GetMultipleFiles(maximumFileCount: 6);
            foreach (var file in files)
            {
                if (_listing.Photos.Count >= 6)
                {
                    _photoUploadError = "Maximum of 6 photos allowed per listing.";
                    break;
                }

                // Check file format
                if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                {
                    _photoUploadError = $"'{file.Name}' is not a supported image file.";
                    continue;
                }

                // Downscale image client-side to max 1200x1200 for fast upload and lightweight storage
                var resized = await file.RequestImageFileAsync("image/jpeg", 1200, 1200);
                using var stream = resized.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                var base64 = Convert.ToBase64String(ms.ToArray());
                var dataUrl = $"data:image/jpeg;base64,{base64}";
                _listing.Photos.Add(dataUrl);
            }
        }
        catch (Exception ex)
        {
            _photoUploadError = $"Failed to process image: {ex.Message}";
        }
        finally
        {
            _isUploadingPhotos = false;
            StateHasChanged();
        }
    }

    private void RemovePhoto(int index)
    {
        if (index >= 0 && index < _listing.Photos.Count)
        {
            _listing.Photos.RemoveAt(index);
        }
    }

    private void MakePhotoCover(int index)
    {
        if (index > 0 && index < _listing.Photos.Count)
        {
            var item = _listing.Photos[index];
            _listing.Photos.RemoveAt(index);
            _listing.Photos.Insert(0, item);
        }
    }

    private void AddManualPhotoUrl()
    {
        if (string.IsNullOrWhiteSpace(_manualPhotoUrl)) return;
        var url = _manualPhotoUrl.Trim();
        if (_listing.Photos.Count >= 6)
        {
            _photoUploadError = "Maximum of 6 photos allowed per listing.";
            return;
        }
        _listing.Photos.Add(url);
        _manualPhotoUrl = string.Empty;
        _showUrlInput = false;
    }

    private void CloseValidationModal()
    {
        _showValidationModal = false;
    }

    private bool _isPublishing = false;

    private async Task HandlePublishListing()
    {
        _validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(_listing.Title))
        {
            _validationErrors.Add("Listing Title is required.");
        }

        if (string.IsNullOrWhiteSpace(_listing.Brand))
        {
            _validationErrors.Add("Brand / Manufacturer is required.");
        }

        if (_listing.Price <= 0)
        {
            _validationErrors.Add("Listing Price must be greater than ₱0.");
        }

        if (string.IsNullOrWhiteSpace(_listing.Description))
        {
            _validationErrors.Add("Item Description & Accessories details are required.");
        }

        if (_listing.Photos.Count == 0)
        {
            _validationErrors.Add("Please upload at least one photo of the item.");
        }

        if (_validationErrors.Count > 0)
        {
            _showValidationModal = true;
            ToastService.ShowWarning("Please fix the missing required fields to publish.", "Incomplete Listing");
            return;
        }

        _isPublishing = true;
        StateHasChanged();

        await Task.Delay(250);

        _listing.SellerId = CurrentUserService.UserId;
        _listing.WarrantyOffered = _selectedWarrantyDays > 0 ? _selectedWarrantyDays : null;
        _listing.Grade = CurrentCalculatedGrade;

        var created = ListingService.CreateListing(_listing);
        _isPublishing = false;

        ToastService.ShowSuccess("Your listing has been verified and published successfully!", "Listing Published");
        NavigationManager.NavigateTo($"/listing/{created.Id}");
    }
}
